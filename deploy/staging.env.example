# Copy to /etc/intertop-training/staging.env and replace every placeholder.
# Keep this file owned by root and readable only by the intertop group.

INTERTOP_ENV=staging
INTERTOP_ALLOWED_HOSTS=staging.example.com
WEB_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# The application is intentionally private; Nginx is its only public entry point.
INTERTOP_WEB_HOST=127.0.0.1
INTERTOP_WEB_PORT=8000
INTERTOP_FORWARDED_ALLOW_IPS=127.0.0.1

# Persistent state stays outside the Git checkout.
INTERTOP_DB_PATH=/srv/intertop-training/data/training.db
INTERTOP_COURSES_DIR=/srv/intertop-training/courses
INTERTOP_UPLOAD_DIR=/srv/intertop-training/uploads

# Optional: enables AI-backed features. Do not add this value to Git.
# OPENAI_API_KEY=

# Optional: required only when the Telegram bot is deployed separately.
# BOT_TOKEN=
