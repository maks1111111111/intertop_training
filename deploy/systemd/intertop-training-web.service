[Unit]
Description=Intertop Training web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=intertop
Group=intertop
WorkingDirectory=/opt/intertop-training
EnvironmentFile=/etc/intertop-training/staging.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/intertop-training/.venv/bin/python -m app.database.migrate
ExecStartPre=/opt/intertop-training/.venv/bin/python -m app.deployment_audit
ExecStart=/opt/intertop-training/.venv/bin/python -m app.web_server
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
UMask=0077

# The web process has no reason to write into code, home directories, or devices.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/intertop-training
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
