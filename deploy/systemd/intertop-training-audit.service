[Unit]
Description=Tenant and platform integrity audit for Mentor Connect
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=intertop
Group=intertop
WorkingDirectory=/opt/intertop-training
EnvironmentFile=/etc/intertop-training/staging.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/intertop-training/.venv/bin/python -m app.deployment_audit
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
# SQLite can create WAL/-shm sidecar files even for an audit connection.
ReadWritePaths=/srv/intertop-training/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
